[sub_resource type="Resource" id="ab_flash"]
script = ExtResource("2")
id = &"flash"
display_name = "Pop Flash"
description = "Throw a flash that detonates after a short fuse: white-out up to 2s by angle/distance/LOS. Affects allies too."
cost = 250
max_charges = 2
signature = false
cooldown = 0.0
map_targeted = false
icon_color = Color(0.95, 0.85, 0.35, 1)

[sub_resource type="Resource" id="ab_recon"]
